{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiMi batch output validation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "batch_id", "artifact_path", "artifact_sha256", "input_path", "input_sha256", "input_ids", "record_revisions", "schema_version", "schemas", "checks", "command"],
  "properties": {
    "schema": {"const": "jp-deck-batch-output-validation/v1"},
    "status": {"const": "pass"},
    "batch_id": {"type": "string", "minLength": 1},
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_path": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "record_revisions": {"$ref": "#/$defs/revisions"},
    "schema_version": {"type": "string", "minLength": 1},
    "schemas": {"type": "object", "additionalProperties": false, "required": ["input_sha256", "output_sha256"], "properties": {"input_sha256": {"$ref": "#/$defs/hash"}, "output_sha256": {"$ref": "#/$defs/hash"}}},
    "checks": {"type": "object", "additionalProperties": false, "required": ["schema", "membership", "references", "render"], "properties": {"schema": {"const": true}, "membership": {"const": true}, "references": {"const": true}, "render": {"const": true}}},
    "command": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revisions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}}
  }
}
