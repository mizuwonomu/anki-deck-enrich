{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic aggregate provenance v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "serialization", "config", "review_scope", "manifest", "contract", "schemas", "master", "native_source_linkage", "acceptances", "batches", "aggregate", "rows"],
  "properties": {
    "schema": {"enum": ["jp-deck-aggregate-provenance/v1", "jp-deck-aggregate-provenance/v2"]},
    "serialization": {"const": "jsonl-utf8-compact-ensure-ascii-false-v1"},
    "config": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "review_scope": {"enum": ["structure-and-collocation-attestation/v1", "schema-first-sampled-source/v1"]},
    "manifest": {"$ref": "#/$defs/file_binding"},
    "contract": {"$ref": "#/$defs/file_binding"},
    "schemas": {"type": "object", "additionalProperties": false, "required": ["input_sha256", "output_sha256"], "properties": {"input_sha256": {"$ref": "#/$defs/hash"}, "output_sha256": {"$ref": "#/$defs/hash"}}},
    "master": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "count", "input_ids"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "count": {"type": "integer", "minimum": 1}, "input_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "native_source_linkage": {"type": "object", "additionalProperties": false, "required": ["verified", "evidence"], "properties": {"verified": {"type": "boolean"}, "evidence": {"type": "object"}}},
    "acceptances": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_binding"}},
    "batches": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["batch_id", "input_path", "input_sha256", "input_ids", "output_path", "output_sha256", "artifact_revision", "record_revisions", "validation_path", "validation_sha256", "review_path", "review_sha256"], "properties": {"batch_id": {"type": "string", "minLength": 1}, "input_path": {"type": "string", "minLength": 1}, "input_sha256": {"$ref": "#/$defs/hash"}, "input_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "output_path": {"type": "string", "minLength": 1}, "output_sha256": {"$ref": "#/$defs/hash"}, "artifact_revision": {"type": "integer", "minimum": 1}, "record_revisions": {"$ref": "#/$defs/revisions"}, "validation_path": {"type": "string", "minLength": 1}, "validation_sha256": {"$ref": "#/$defs/hash"}, "review_path": {"type": "string", "minLength": 1}, "review_sha256": {"$ref": "#/$defs/hash"}}}},
    "aggregate": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "count", "input_ids", "unique_count", "record_revisions"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "count": {"type": "integer", "minimum": 1}, "input_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "unique_count": {"type": "integer", "minimum": 1}, "record_revisions": {"$ref": "#/$defs/revisions"}}},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["row", "input_id", "batch_id", "source_output_path", "source_output_sha256", "source_record_number", "record_revision"], "properties": {"row": {"type": "integer", "minimum": 1}, "input_id": {"type": "string", "minLength": 1}, "batch_id": {"type": "string", "minLength": 1}, "source_output_path": {"type": "string", "minLength": 1}, "source_output_sha256": {"$ref": "#/$defs/hash"}, "source_record_number": {"type": "integer", "minimum": 1}, "record_revision": {"type": "integer", "minimum": 1}}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "revisions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}}
  }
}
